{
  "name": "pricewatch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/extract.test.js test/parse.test.js test/alerts.test.js",
    "test:worker": "vitest run",
    "test:all": "npm test && npm run test:worker",
    "db:migrate": "wrangler d1 migrations apply pricewatch --remote",
    "db:migrate:local": "wrangler d1 migrations apply pricewatch --local",
    "db:bootstrap": "wrangler d1 execute pricewatch --remote --file=scripts/bootstrap-d1-migrations-remote.sql",
    "db:bootstrap:local": "wrangler d1 execute pricewatch --local --file=scripts/bootstrap-d1-migrations-local.sql",
    "deploy": "npm run db:migrate && wrangler deploy",
    "db:init": "wrangler d1 execute pricewatch --remote --file=schema.sql",
    "db:local": "wrangler d1 execute pricewatch --local --file=schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "vitest": "^4.1.10",
    "wrangler": "^4"
  }
}
