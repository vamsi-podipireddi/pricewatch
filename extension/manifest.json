{
  "manifest_version": 3,
  "name": "PriceWatch",
  "version": "1.4.0",
  "description": "Track any product's price. Popup shows price + trend; passive capture and auto-sync keep bot-walled stores fresh from your browser.",
  "action": {
    "default_title": "PriceWatch",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
